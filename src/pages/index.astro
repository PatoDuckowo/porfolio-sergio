---
import Welcome from "../components/Welcome.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";
import Badge from "../components/Badge.astro";
import Linkedl from "../components/Icons/Linkedl.astro";
import Github from "../components/Icons/Github.astro";
import Pildoras from "../components/Pildoras.astro";
import Email from "../components/Icons/Email.astro";
import Experiencia from "../components/Experiencia.astro";
import Maletin from "../components/Icons/Maletin.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Code from "../components/Icons/Code.astro";
import Proyectos from "../components/Proyectos.astro";
import Footer from "../components/Footer.astro";
import Competencias from "../components/Competencias.astro";
import Formacion from "../components/Formacion.astro";
---

<Layout
	title="Sergio David Diaz | Técnico CAU y soporte IT"
	description="Técnico de soporte IT en Madrid con 4 años en el sector y experiencia en el CAU de KPMG. ServiceNow, Active Directory, Microsoft 365 e Intune. Finalizando DAM."
>
		
		
<main class="w-full min-w-0 px-4 overflow-x-hidden text-white">
    <Header />

    <section class="w-full lg:w-[740px] mx-auto py-10 px-4 mt-10" id="sobre-mi">
        <h1 class="text-white text-3xl md:text-4xl lg:text-5xl font-bold text-center pb-3">
            Sergio David Diaz
        </h1>
        <p class="text-xl md:text-2xl font-semibold text-center text-yellow-200 pb-6">
            Técnico CAU y soporte IT, orientado a sistemas
        </p>
        <div class="flex justify-center">
            <Badge>FINALIZANDO DAM</Badge>
        </div>
		<div class="text-lg md:text-xl lg:text-2xl max-w-full md:max-w-[600px] mx-auto text-left md:text-justify leading-relaxed mt-6 md:mt-8 space-y-4">
			<p>
				4 años en el sector IT, con experiencia en el CAU de KPMG atendiendo
				a usuarios de toda España por Teams, correo, teléfono y en remoto.
			</p>
			<p>
				Trabajo con
				<span class="text-orange-300/100">ServiceNow, Active Directory, Microsoft 365 e Intune.</span>
			</p>
			<p>
				Estoy terminando el Grado Superior en DAM y monto mis propios proyectos con
				<span class="text-orange-300/100">Python, Docker y Linux.</span>
			</p>
			<p class="opacity-80">
				Vivo en <span class="text-yellow-200/100">Madrid, España.</span>
				Busco crecer en sistemas y CAU, y también me interesa el desarrollo.
			</p>
		</div>
		<div class="flex flex-col md:flex-row justify-center items-center gap-y-4 md:gap-x-10 mt-10">
			<Pildoras>
				<a href="https://github.com/PatoDuckowo" target="_blank" rel="noopener noreferrer" class="flex items-center gap-x-2">
					<Github class="size-12" />
					<span>Github</span>
				</a>
			</Pildoras>
			<Pildoras>
				<a href="https://www.linkedin.com/in/sergio-david-diaz-incahuanaco-370585268/" target="_blank" rel="noopener noreferrer" class="flex items-center gap-x-2">
					<Linkedl class="size-12" />
					<span>LinkedIn</span>
				</a>
			</Pildoras>
			<Pildoras>
				<a href="mailto:sergio305david@gmail.com" class="flex items-center gap-x-2">
					<Email class="size-8" />
					<span>sergio305david@gmail.com</span>
				</a>
			</Pildoras>
		</div>
    </section>

    <h2
        id="experiencia"
        class="text-white text-3xl font-bold flex-row flex justify-center items-center gap-x-4 pb-8 scroll-mt-6"
    >
        <Maletin /> Experiencia
    </h2>

    <Experiencia />

    <h2
        id="competencias"
        class="text-white text-3xl font-bold flex justify-center pb-8 mt-6 scroll-mt-6"
    >
        Competencias
    </h2>

    <Competencias />

    <h2
        class="text-white text-2xl font-bold flex justify-center mt-10 px-4"
        id="proyectos"
    >
        <Code class="size-8 pr-2" /> PROYECTOS REALIZADOS
    </h2>
    <section class="w-full lg:w-[740px] mx-auto py-10 px-4">
        <Proyectos class="text-white text-2xl font-bold flex justify-center"></Proyectos>
    </section>

    <h2
        id="formacion"
        class="text-white text-3xl font-bold flex justify-center pb-8 mt-6 scroll-mt-6"
    >
        Formación
    </h2>

    <div class="pb-10">
        <Formacion />
    </div>
</main>
		<Footer></Footer>
	</Layout>


