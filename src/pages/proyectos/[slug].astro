---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Pildoras from "../../components/Pildoras.astro";
import "../../styles/global.css";
import { PROYECTOS } from "../../data/proyectos.js";
import { ruta } from "../../utils/ruta.js";

export function getStaticPaths() {
  return PROYECTOS.map((proyecto) => ({
    params: { slug: proyecto.slug },
    props: { proyecto },
  }));
}

const { proyecto } = Astro.props;
const { titulo, etiqueta, resumen, descripcion, tags, puntos, capturas, enlaces, nota } = proyecto;
---

<Layout title={`${titulo} | Sergio David Diaz`} description={resumen}>
  <main class="w-full min-w-0 px-4 overflow-x-hidden text-white">
    <Header />

    <article class="w-full lg:w-[740px] mx-auto py-10 px-4">
      <a href={ruta("/#proyectos")} class="text-orange-300 hover:underline">← Volver a proyectos</a>

      <p class="text-sm text-white/70 mt-8 mb-1">{etiqueta}</p>
      <h1 class="text-3xl md:text-4xl font-bold text-yellow-200 mb-4">{titulo}</h1>
      <p class="text-lg text-pretty mb-6">{descripcion}</p>

      <ul class="flex flex-wrap gap-2 mb-8">
        {tags.map((tag) => <li><Pildoras>{tag}</Pildoras></li>)}
      </ul>

      <h2 class="text-2xl font-semibold mb-3">Qué incluye</h2>
      <ul class="list-disc pl-5 space-y-2 mb-8">
        {puntos.map((punto) => <li>{punto}</li>)}
      </ul>

      <h2 class="text-2xl font-semibold mb-3">Capturas</h2>
      <div class="space-y-6 mb-8">
        {capturas.map(({ src, alt, pie }) => (
          <figure>
            <img class="w-full rounded-lg border border-white/10" src={ruta(src)} alt={alt} loading="lazy" />
            <figcaption class="text-sm text-white/70 mt-2">{pie}</figcaption>
          </figure>
        ))}
      </div>

      {nota && <p class="text-sm text-white/70 mb-6">{nota}</p>}

      {enlaces.map(({ texto, url }) => (
        <a
          href={url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block rounded-full border border-white/20 px-4 py-2 font-semibold hover:border-yellow-200/60 transition-colors"
        >
          {texto} ↗
        </a>
      ))}
    </article>
  </main>
  <Footer />
</Layout>
