---
const FORMACION = [
  {
    titulo: "Grado Superior en Desarrollo de Aplicaciones Multiplataforma (DAM)",
    centro: "Digitech FP",
    fecha: "2024 – 2026 · Pendiente del proyecto final (TFG)",
  },
  {
    titulo: "Grado Medio Técnico en Telecomunicaciones",
    centro: "IES San Blas, Madrid",
    fecha: "2019 – 2021",
  },
];
---

<ul class="w-full max-w-3xl mx-auto space-y-6">
  {FORMACION.map(({ titulo, centro, fecha }) => (
    <li>
      <h3 class="text-lg font-semibold text-yellow-200">{titulo}</h3>
      <p class="text-base text-white/90">{centro}</p>
      <p class="text-sm text-white/80">{fecha}</p>
    </li>
  ))}
</ul>
