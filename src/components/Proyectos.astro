---
import { PROYECTOS } from "../data/proyectos.js";
import Pildoras from "./Pildoras.astro";
---

<div class="grid grid-cols-1 gap-8">
  {PROYECTOS.map(({ slug, titulo, etiqueta, resumen, tags, capturas }) => (
    <a
      href={`/proyectos/${slug}/`}
      class="block rounded-lg border border-white/10 overflow-hidden bg-white/5 hover:border-yellow-200/60 transition-colors"
    >
      <img
        class="w-full aspect-video object-cover object-top"
        src={capturas[0].src}
        alt={capturas[0].alt}
        loading="lazy"
      />
      <div class="p-5">
        <p class="text-sm text-white/70 mb-1">{etiqueta}</p>
        <h3 class="text-2xl font-semibold text-yellow-200 mb-2">{titulo}</h3>
        <p class="text-base text-pretty mb-4">{resumen}</p>
        <ul class="flex flex-wrap gap-2 mb-4">
          {tags.map((tag) => <li><Pildoras>{tag}</Pildoras></li>)}
        </ul>
        <span class="font-semibold text-orange-300">Ver proyecto →</span>
      </div>
    </a>
  ))}
</div>
